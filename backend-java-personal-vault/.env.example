# Copy to .env (or export as real environment variables) — never commit real secrets.

DB_URL=jdbc:mysql://localhost:3306/personal_vault
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

CORS_ALLOWED_ORIGINS=http://localhost:5173

STORAGE_PATH=./storage/documents

# Keep true except for local HTTP-only frontend dev (see AuthContext.md's known-gaps note) —
# never set to false in a real deployment.
COOKIE_SECURE=true
